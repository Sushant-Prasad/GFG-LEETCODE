class Solution {
    /**
     * Problem: Minimum number of jumps to reach the end of the array.
     *
     * Each element in arr[] represents the maximum number of steps
     * you can jump forward from that element.
     * Return the minimum jumps needed to reach the last index,
     * or -1 if it is not possible.
     *
     * Approach (Greedy):
     * -----------------
     * 1. Use three variables:
     *    - maxRange → the farthest index we can reach so far
     *    - choice   → the boundary of the current jump
     *    - jumps    → number of jumps taken
     *
     * 2. Iterate over the array:
     *    - Update maxRange = max(maxRange, i + arr[i]) to track the farthest index reachable.
     *    - When we reach the current boundary (i == choice):
     *         → It means we must take a jump.
     *         → Update choice = maxRange (extend the boundary).
     *         → Increment jump count.
     *    - If at any point choice >= n-1, we can reach the end → return jumps.
     *
     * 3. If we finish the loop and haven't reached the end → return -1.
     *
     * Example:
     * arr = [2, 3, 1, 1, 4]
     * - Start: maxRange = 0, choice = 0, jumps = 0
     * - i=0 → maxRange = 2, i==choice → choice=2, jumps=1
     * - i=1 → maxRange = 4
     * - i=2 → i==choice → choice=4, jumps=2 → choice>=n-1 → return 2
     *
     * Time Complexity:
     * - O(n): Single traversal of the array
     *
     * Space Complexity:
     * - O(1): Only a few variables used
     */
    public int minJumps(int[] arr) {
        int n = arr.length;

        int maxRange = 0; // farthest index reachable so far
        int choice = 0;   // boundary of current jump
        int jumps = 0;    // number of jumps taken

        for (int i = 0; i < n; i++) {
            // Update farthest reachable index
            maxRange = Math.max(maxRange, i + arr[i]);

            // If we reached the end of current range, we must jump
            if (i == choice) {
                choice = maxRange;
                jumps++;
            }

            // If we can already reach or cross the last index
            if (choice >= n - 1) {
                return jumps;
            }
        }

        return -1; // end not reachable
    }
}
