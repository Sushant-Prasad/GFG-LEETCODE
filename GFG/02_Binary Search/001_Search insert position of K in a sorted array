class Solution {

    // =========================================================================
    //  TITLE:
    //  Search Insert Position (Lower Bound using Binary Search)
    // =========================================================================
    //
    //  PROBLEM STATEMENT:
    //  ------------------
    //  Given a sorted array `arr[]` (0-indexed) of DISTINCT integers and
    //  an integer `k`:
    //
    //  • If `k` is present in the array → return its index
    //  • If `k` is NOT present → return the index where `k` should be
    //    inserted to maintain the sorted order
    //
    // =========================================================================
    //  PROBLEM RESOURCE:
    //  -----------------
    //  https://leetcode.com/problems/search-insert-position/
    //  https://www.geeksforgeeks.org/problems/search-insert-position-of-k-in-a-sorted-array/
    //
    // =========================================================================
    //  INTUITION:
    //  ----------
    //  • Since the array is already sorted, Binary Search can be used.
    //  • We are looking for the FIRST position where:
    //
    //        arr[index] >= k
    //
    //  • This position works for BOTH cases:
    //      ✔ If arr[index] == k → element found
    //      ✔ If arr[index] >  k → correct insertion index
    //
    //  • This concept is known as the LOWER BOUND.
    //
    // =========================================================================
    //  APPROACH (BINARY SEARCH – LOWER BOUND):
    //  ---------------------------------------
    //  1. Initialize two pointers:
    //      • l = 0
    //      • r = arr.length - 1
    //  2. Maintain an `ans` variable to store the possible index.
    //  3. Perform binary search:
    //      • If arr[mid] >= k:
    //            → mid can be the answer
    //            → move LEFT to find a smaller index
    //      • Else:
    //            → move RIGHT
    //  4. Return `ans`
    //
    // =========================================================================
    //  SPECIAL NOTES FOR LOGIC ⭐:
    //  --------------------------
    //  • `ans` is initialized to arr.length:
    //        → This handles the case where `k` is larger than all elements.
    //        → In such a case, `k` should be inserted at the END.
    //
    //  • Condition `arr[mid] >= k`:
    //        → Ensures we find the FIRST position where k can appear.
    //
    // =========================================================================
    //  EXAMPLE:
    //  --------
    //  Input:
    //      arr = [1, 3, 5, 6]
    //      k = 2
    //
    //  Output:
    //      1
    //
    // =========================================================================
    //  DRY RUN:
    //  --------
    //  arr = [1, 3, 5, 6], k = 2
    //
    //  l=0, r=3, ans=4
    //  mid=1 → arr[1]=3 >= 2
    //          ans=1, r=0
    //
    //  mid=0 → arr[0]=1 < 2
    //          l=1
    //
    //  Loop ends → return ans = 1
    //
    // =========================================================================
    //  KEY POINTS:
    //  ------------
    //  ✔ Works for both FOUND and NOT FOUND cases
    //  ✔ Uses lower bound concept
    //  ✔ Optimal solution using Binary Search
    //  ✔ No extra space used
    //
    // =========================================================================
    //  TIME COMPLEXITY:
    //      O(log n)
    //
    //  SPACE COMPLEXITY:
    //      O(1)
    //
    // =========================================================================
    public int searchInsertK(int arr[], int k) {

        int l = 0, r = arr.length - 1;
        int ans = arr.length;   // Default insert position (end)

        while (l <= r) {

            int mid = l + (r - l) / 2;

            // If current element is >= k, it can be the answer
            if (arr[mid] >= k) {
                ans = mid;      // store index
                r = mid - 1;    // search left half
            }
            // Otherwise, search right half
            else {
                l = mid + 1;
            }
        }

        return ans;
    }
}
