/*
===========================================================
TITLE
===========================================================
Count Occurrences of X in Given Index Ranges Using Binary Search

===========================================================
PROBLEM STATEMENT
===========================================================
You are given:
1) A sorted integer array `arr`
2) A list of queries, where each query is of the form:
   [l, r, x]

For each query, determine how many times the value `x`
appears in the array `arr` between indices `l` and `r` (inclusive).

Return an ArrayList containing the answer for each query.

===========================================================
PROBLEM RESOURCE (REFERENCE LINKS)
===========================================================
• https://www.geeksforgeeks.org/problems/count-x-in-range-of-a-sorted-array/1

===========================================================
INTUITION
===========================================================
Since the array is already sorted:
- All occurrences of a value `x` will be in a contiguous block.
- We can efficiently find:
  • The first occurrence of `x` (lower bound)
  • The position just after the last occurrence of `x` (upper bound)

Using these two indices, we can compute how many times `x`
appears within a given index range [l, r].

===========================================================
APPROACH
===========================================================
1) Implement `lowerbound`:
   - Finds the first index where value >= target

2) Implement `upperbound`:
   - Finds the first index where value > target

3) For each query:
   - Find the global range of `x` using lower & upper bound
   - Intersect that range with the query range [l, r]
   - Count elements if intersection exists

===========================================================
EXAMPLE
===========================================================
arr = [1, 2, 2, 2, 3, 4]
query = [1, 4, 2]

lowerbound(2) = 1
upperbound(2) = 4  → last occurrence index = 3

Valid x-range = [1, 3]
Query range    = [1, 4]

Intersection   = [1, 3]
Answer         = 3

===========================================================
DRY RUN (ONE QUERY)
===========================================================
arr = [1,2,2,2,3,4]
query = [2,5,2]

lower = 1
upper = 4 → right = 3

start = max(1,2) = 2
end   = min(3,5) = 3

count = end - start + 1 = 2

===========================================================
KEY POINTS
===========================================================
• Array must be sorted
• Binary search reduces query time drastically
• Intersection logic avoids out-of-bound counting
• Efficient for large input sizes

===========================================================
TIME COMPLEXITY
===========================================================
Lower Bound:   O(log N)
Upper Bound:   O(log N)
Each Query:    O(log N)

Total: O(Q log N)

===========================================================
SPACE COMPLEXITY
===========================================================
O(1) extra space (excluding output list)

===========================================================
SPECIAL NOTES FOR LOGIC
===========================================================
• `upperbound - 1` gives the last index of `x`
• `Math.max` and `Math.min` ensure range safety
• If start > end → no valid occurrence
===========================================================
*/

class Solution {

    // Finds the first index where arr[index] >= target
    private int lowerbound(int[] arr , int target){
        int l = 0, r = arr.length;
        while(l < r){
            int mid = l + (r - l) / 2; // Prevents integer overflow
            if(arr[mid] < target)
                l = mid + 1; // Move right if mid value is smaller
            else
                r = mid;     // Possible answer, move left
        }
        return r; // First index where value >= target
    }

    // Finds the first index where arr[index] > target
    private int upperbound(int[] arr , int target){
        int l = 0, r = arr.length;
        while(l < r){
            int mid = l + (r - l) / 2; // Mid calculation
            if(arr[mid] <= target)
                l = mid + 1; // Skip all values <= target
            else
                r = mid;     // First value > target
        }
        return r; // Index after last occurrence of target
    }

    public ArrayList<Integer> countXInRange(int[] arr, int[][] queries) {

        ArrayList<Integer> res = new ArrayList<>();

        // Process each query independently
        for(int[] q : queries){

            int l = q[0]; // Left index of query range
            int r = q[1]; // Right index of query range
            int x = q[2]; // Target value

            // Global occurrence range of x in array
            int left = lowerbound(arr, x);       // First x index
            int right = upperbound(arr, x) - 1;  // Last x index

            // Intersect global x-range with query range
            int start = Math.max(left, l);
            int end   = Math.min(right, r);

            // If no overlap, count is zero
            if(start > end)
                res.add(0);
            else
                res.add(end - start + 1); // Number of valid occurrences
        }

        return res;
    }
}
